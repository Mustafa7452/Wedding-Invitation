{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/decor/**",
              "components/invitation/**",
              "ui_kits/invitation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|Pinyon Script|Jost))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, Pinyon Script, Jost."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|style|key|ref|className|style|children)$/]",
        "message": "<ArchFrame> doesn't accept that prop. Declared props: children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid|ghost)$/]",
        "message": "<Button> variant must be one of 'outline' | 'solid' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:target|labels|className|style|key|ref|className|style|children)$/]",
        "message": "<Countdown> doesn't accept that prop. Declared props: target, labels, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|width|className|style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: variant, width, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:diamond|flourish)$/]",
        "message": "<Divider> variant must be one of 'diamond' | 'flourish'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:tight|default|wide)$/]",
        "message": "<Divider> width must be one of 'tight' | 'default' | 'wide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ornament'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|flip|className|style|key|ref|className|style|children)$/]",
        "message": "<Ornament> doesn't accept that prop. Declared props: name, size, flip, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ornament'] > JSXAttribute[name.name='flip'] > Literal[value!=/^(?:x|y|xy)$/]",
        "message": "<Ornament> flip must be one of 'x' | 'y' | 'xy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RevealCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|revealed|defaultRevealed|onReveal|className|style|key|ref|className|style|children)$/]",
        "message": "<RevealCard> doesn't accept that prop. Declared props: value, label, revealed, defaultRevealed, onReveal, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|size|face|divider|className|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: title, eyebrow, size, face, divider, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md)$/]",
        "message": "<SectionHeading> size must be one of 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='face'] > Literal[value!=/^(?:script|serif)$/]",
        "message": "<SectionHeading> face must be one of 'script' | 'serif'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='divider'] > Literal[value!=/^(?:diamond|flourish|none)$/]",
        "message": "<SectionHeading> divider must be one of 'diamond' | 'flourish' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwatchRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:colors|className|style|key|ref|className|style|children)$/]",
        "message": "<SwatchRow> doesn't accept that prop. Declared props: colors, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|title|icon|key|ref|className|style|children)$/]",
        "message": "<TimelineEntry> doesn't accept that prop. Declared props: time, title, icon."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
